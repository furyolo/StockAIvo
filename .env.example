# ==================== Timezone Configuration ====================
# Set the timezone for the application (default: Etc/UTC)
# This will use Coordinated Universal Time (UTC+0) consistently year-round
TZ=Etc/UTC

# LLM Service Configuration
OPENAI_API_BASE=""
OPENAI_API_KEY=""

# AI Agent Model Configuration
# Default model for all agents (used when no specific override is set)
AI_DEFAULT_MODEL="gemini-2.5-flash"

# Agent-specific model overrides (leave empty to use default)
AI_TECHNICAL_ANALYSIS_MODEL="gemini-2.5-pro"
AI_SYNTHESIS_MODEL="gemini-2.5-pro"

DATABASE_URL="postgresql://stockaivo:StockAIvo_2025#Secure!@localhost:5432/stock"

DOCKER_DATABASE_URL="postgresql://postgres:StockAIvo_2025#Secure!@localhost:5432/stockaivo"

# ==================== Database Migration Configuration ====================
# Control whether to run database migrations on startup (default: true)
# Set to "false" to disable automatic migrations for existing databases
RUN_DATABASE_MIGRATIONS=true

# ==================== Middleware Configuration ====================
# All middleware is enabled by default for security and monitoring
# Set to "false" to disable specific middleware if needed

# Slow Request Detection Threshold (seconds)
# Requests taking longer than this will be logged as warnings
SLOW_REQUEST_THRESHOLD=1.0

# Optional: Disable specific middleware (uncomment if needed)
# MIDDLEWARE_REQUEST_LOGGING=false
# MIDDLEWARE_PERFORMANCE_MONITORING=false
# MIDDLEWARE_SECURITY_HEADERS=false