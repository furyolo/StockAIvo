ENVIRONMENT=docker

# Docker Compose maps host.docker.internal to the host gateway via
# extra_hosts: "host.docker.internal:host-gateway", which works across
# Windows, macOS, and modern Linux Docker setups. If your Docker engine does
# not support host-gateway, replace the value below with your host machine IP.
OPENAI_API_BASE="http://host.docker.internal:3222/v1"
